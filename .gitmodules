[submodule "External/hlslpp"]
	path = External/hlslpp
	url = https://github.com/redorav/hlslpp.git
	shallow = true
[submodule "External/entt"]
	path = External/entt
	url = https://github.com/skypjack/entt.git
	shallow = true
[submodule "External/DirectXTex"]
	path = External/DirectXTex
	url = https://github.com/microsoft/DirectXTex.git
	shallow = true
[submodule "External/cereal"]
	path = External/cereal
	url = https://github.com/USCiLab/cereal.git
	shallow = true
[submodule "External/JoltPhysics"]
	path = External/JoltPhysics
	url = https://github.com/jrouwe/JoltPhysics.git
	shallow = true
[submodule "External/Effekseer"]
	# 自前のフォーク。ピン留めしているのは tsukino-engine ブランチ先端の SHA。
	#
	# サブモジュールが記録するのは SHA だけで、到達経路はこのブランチ 1 本しかない。
	# ブランチを force-push / 削除すると、その SHA を指したままの過去のリリースは
	# clone できなくなる（fatal: reference is not a tree）。手元は既に持っているので
	# 気付けず、壊れるのは新しく clone した人だけになる。
	#
	# リリースを打つときは、そのピンへ tsukino-engine-vX.Y.Z のタグを付けて、
	# ブランチとは独立に到達可能にしておくこと。
	path = External/Effekseer
	url = https://github.com/tsukinokun/Effekseer.git
	shallow = true
[submodule "External/SDL"]
	path = External/SDL
	url = https://github.com/libsdl-org/SDL.git
	shallow = true
# bgfx.cmake（CMake の手順）と、bgfx・bimg・bx 本体。
#
# 本体の 3 つは、bgfx.cmake の CMakeLists.txt が FetchContent_Declare で固定している
# GIT_TAG と同じコミットに合わせる。ずらすと bgfx.cmake の想定と違うソースをビルドすることになる。
# bgfx.cmake を更新するときは、その GIT_TAG を見て 3 つも一緒に動かすこと。
# （本体を submodule にしているのは、ビルドのたびにネットから取らずに済ませるため）
[submodule "External/bgfx.cmake"]
	path = External/bgfx.cmake
	url = https://github.com/bkaradzic/bgfx.cmake.git
	shallow = true
[submodule "External/bx"]
	path = External/bx
	url = https://github.com/bkaradzic/bx.git
	shallow = true
[submodule "External/bimg"]
	path = External/bimg
	url = https://github.com/bkaradzic/bimg.git
	shallow = true
[submodule "External/bgfx"]
	path = External/bgfx
	url = https://github.com/bkaradzic/bgfx.git
	shallow = true
