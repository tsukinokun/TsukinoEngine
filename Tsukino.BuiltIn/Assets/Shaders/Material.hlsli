//--------------------------------------------------------------
//! @file   Material.hlsli
//! @brief  マテリアル定数バッファ(b2)とリムグローの共通定義
//! @author 山﨑愛
//! @note   b2のレイアウトと、リムグローの式が乖離しないよう、ここに一元化する
//--------------------------------------------------------------
#ifndef TSUKINO_MATERIAL_HLSLI
#define TSUKINO_MATERIAL_HLSLI

//--------------------------------------------------------------
//! マテリアル定数バッファ (b2)
//--------------------------------------------------------------
cbuffer CBufferMaterial : register(b2)
{
    float4 baseColor;      // 0
    float3 emissive;       // 16
    float  emissivePad;    // 28（C++のhlslpp::float3が持つ4番目のレーンに対応）
    float  metallic;       // 32
    float  roughness;      // 36
    float  specular;       // 40
    float  alphaCutoff;    // 44（アルファテストのしきい値。0=無効）
    float4 rimColor;       // 48  xyz: ふちの色, w: ふちの強さ
    float4 rimParams;      // 64  x: ふちの鋭さ(pow指数), y: 全体の白発光量, zw: 予約
};

//--------------------------------------------------------------
//! 輪郭の発光量（リム）を求めます。
//! @param  [in] N 正規化済みのワールド法線
//! @param  [in] V 正規化済みの視線ベクトル（ピクセル → カメラ）
//! @return ふちの発光色。リム無効時はゼロ
//--------------------------------------------------------------
float3 EvaluateRimGlow(float3 N, float3 V)
{
    //----------------------------------------------------------
    // 面がカメラに対してどれだけ正面を向いているか（1=正面, 0=真横）。
    // 法線マップで裏向きになった画素は内積が負になり、そのまま反転すると
    // 1を超えて輪郭より強く光ってしまうので、saturateで0〜1に収める
    //----------------------------------------------------------
    const float NdotV = saturate(dot(N, V));

    //----------------------------------------------------------
    // 反転して「輪郭ほど1」にする。
    // max()は数値ガード。powはexp2(e * log2(x))を経由するため、
    // 真正面を向いた画素（1 - NdotV が 0）でNaNになる環境があり、
    // そのままだとトーンマップ後に黒い点として出る
    //----------------------------------------------------------
    const float edge = max(1.0f - NdotV, 1e-6f);

    //----------------------------------------------------------
    // powで光る範囲を輪郭へ寄せる。rimParams.xが大きいほど細い線になる
    //----------------------------------------------------------
    float rim = 0.0f;
    if(rimParams.x > 0.0f) {
        rim = pow(edge, rimParams.x);
    }

    return rimColor.rgb * rim * rimColor.w;
}

//--------------------------------------------------------------
//! エミッシブへ加算する発光の総量を求める
//! @param  [in] N 正規化済みのワールド法線
//! @param  [in] V 正規化済みの視線ベクトル（ピクセル → カメラ）
//! @return リムの発光に、面全体を一律に持ち上げる発光を足した値
//--------------------------------------------------------------
float3 EvaluateEmissiveBoost(float3 N, float3 V)
{
    return EvaluateRimGlow(N, V) + rimParams.y;
}

#endif    // TSUKINO_MATERIAL_HLSLI
