//--------------------------------------------------------------
//! @file   AmbientParticle.ps.hlsl
//! @brief  環境パーティクル用ピクセルシェーダー
//! @author 山﨑愛
//--------------------------------------------------------------
// 板の中心からの距離だけで丸い減衰を作る。テクスチャも定数バッファも
// 一切使わない（色・輝度・フェードは頂点シェーダーが計算し、
// 補間値として受け取る）。
// ブレンドは SRC_ALPHA / ONE の加算合成を前提にしているため、
// 色に事前乗算はしない。
#pragma pack_matrix(row_major)

//--------------------------------------------------------------
// 入力
//--------------------------------------------------------------
struct PSInput
{
    float4 position : SV_POSITION;
    float2 local    : TEXCOORD0;    // 板の中心を原点とした -1〜1 の座標
    float4 color    : COLOR0;       // rgb: 色×輝度, a: フェード量
};

//--------------------------------------------------------------
//! メイン関数
//! @param  [in] input 補間済みの頂点データ
//! @return 加算合成する色
//--------------------------------------------------------------
float4 PSMain(PSInput input) : SV_TARGET
{
    //----------------------------------------------------------
    // 中心からの距離で丸く抜く。四隅（距離約1.41）は完全に0になるので
    // 板の輪郭が四角く見えることはない
    //----------------------------------------------------------
    float r = length(input.local);

    // 外周へ向かってなめらかに0へ。二乗して中心に芯を残す
    float falloff = 1.0f - smoothstep(0.0f, 1.0f, r);
    falloff *= falloff;

    return float4(input.color.rgb, input.color.a * falloff);
}
