//--------------------------------------------------------------
//! @file   Tonemap.hlsli
//! @brief  HDR の色を画面の色にするトーンマップの式
//! @detail Tonemap.ps.hlsl（画面全体）と ScreenModel.ps.hlsl（UI の層に描く 3D モデル）が同じ式を使い、
//!         UI の層のモデルがワールドの絵と同じ明るさ・色味に見えるようにします。
//--------------------------------------------------------------
#ifndef TSUKINO_TONEMAP_HLSLI
#define TSUKINO_TONEMAP_HLSLI

//--------------------------------------------------------------
// 露出倍率。ACESへ入れる前にHDR値へ掛ける。
//
// HDRバッファの値は物理的な輝度ではなく、lightColor.w（ゲーム側が5.0）や
// SkyAtmosphereComponent::sunIntensity（同20.0）といった任意スケールの
// 積み重ねでできている。そのままACESへ入れるとニー（1.0付近）を大きく超えて
// 白へ張り付くので、ここで一度落としてからカーブに乗せる。
//
// 0.6という値に物理的な根拠は無く、既存の絵から引き継いだ経験値。
// 全体の明るさを変えたいときは、ここではなく光源側
// （DirectionalLightComponent::intensity）を動かすほうが筋が良い。
// こちらは空・エミッシブ・パーティクル・フォグまで一律に動かしてしまう
//--------------------------------------------------------------
static const float kExposure = 0.6f;

//--------------------------------------------------------------
//! @brief ACESトーンマッピング
//--------------------------------------------------------------
float3 ACES(float3 x)
{
    float a = 2.51f;
    float b = 0.03f;
    float c = 2.43f;
    float d = 0.59f;
    float e = 0.14f;
    return saturate((x * (a * x + b)) / (x * (c * x + d) + e));
}

//--------------------------------------------------------------
//! @brief HDR の色に露出を掛けてトーンマップし、画面の色にする
//--------------------------------------------------------------
float3 TonemapToDisplay(float3 hdrColor)
{
    return ACES(hdrColor * kExposure);
}

#endif    // TSUKINO_TONEMAP_HLSLI
